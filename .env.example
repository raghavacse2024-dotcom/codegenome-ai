# Backend OAuth & GitHub API
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# AI Providers (Backend Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Security, CORS & Session Encryption
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_ENCRYPTION_KEY=

# Sandbox Execution Configuration
# auto (docker -> remote worker -> dev/test subprocess; fails closed in production if neither docker nor worker is present)
# docker (requires Docker daemon; fails closed if unavailable)
# remote (requires HTTPS SANDBOX_WORKER_URL)
# subprocess (dev/test only; strictly rejected in NODE_ENV=production)
# disabled (always returns SANDBOX_UNAVAILABLE)
SANDBOX_MODE=auto
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=
SANDBOX_ALLOWED_IMAGES=python:3.11-slim,node:22-alpine
SANDBOX_MAX_WORKSPACE_BYTES=10485760
SANDBOX_MAX_FILES=50
SANDBOX_MAX_EXECUTION_MS=8000
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_CPUS=0.5
SANDBOX_MAX_PIDS=64
SANDBOX_MAX_OUTPUT_BYTES=32768
SANDBOX_MAX_CONCURRENT_JOBS=4
SANDBOX_MAX_USER_JOBS=2

# Frontend Build Variable (Vercel -> Backend URL)
VITE_API_URL=
